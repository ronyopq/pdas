{
  "name": "praan-activity-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,WORKER -c cyan,yellow \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --config wrangler.worker.jsonc",
    "build:client": "vite build",
    "build": "npm run build:client",
    "preview": "vite preview --host",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pdas --commit-dirty=true",
    "deploy:worker": "npm run build:client && wrangler deploy --config wrangler.worker.jsonc"
  },
  "dependencies": {
    "docx": "^9.6.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0"
  }
}
